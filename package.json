{
  "name": "sdk-overflow",
  "displayName": "SDK Overflow (Claude Agent SDK)",
  "repository": { "type": "git", "url": "https://github.com/Hanniel95/sdk-overflow" },
  "description": "Agent de code dans Cursor / VS Code, propulsé par le Claude Agent SDK et une clé API de la Claude Console.",
  "version": "0.1.3",
  "publisher": "hanniel-tsasse",
  "author": "Hanniel TSASSE",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentDev",
          "title": "SDK Overflow",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "agentDev": [
        {
          "type": "webview",
          "id": "agentDev.chat",
          "name": "Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "agentDev.setApiKey",
        "title": "SDK Overflow : définir la clé API"
      },
      {
        "command": "agentDev.clearApiKey",
        "title": "SDK Overflow : supprimer la clé API"
      },
      {
        "command": "agentDev.newSession",
        "title": "SDK Overflow : nouvelle session"
      },
      {
        "command": "agentDev.sendSelection",
        "title": "SDK Overflow : envoyer la sélection"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "agentDev.sendSelection",
          "when": "editorHasSelection",
          "group": "agentDev"
        }
      ]
    },
    "keybindings": [
      {
        "command": "agentDev.sendSelection",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "title": "SDK Overflow",
      "properties": {
        "agentDev.model": {
          "type": "string",
          "enum": ["sonnet", "opus", "haiku"],
          "default": "sonnet",
          "description": "Modèle par défaut au démarrage d'une session."
        },
        "agentDev.maxUsd": {
          "type": "number",
          "default": 50,
          "description": "Plafond de dépense (USD) cumulé, mémorisé entre les redémarrages. Au-delà, l'agent refuse les nouveaux prompts."
        },
        "agentDev.confirmShell": {
          "type": "boolean",
          "default": true,
          "description": "Afficher la feuille d'autorisation du panneau avant chaque commande shell. Les modifications de fichiers dépendent du mode (Manuel, Éditer automatiquement, Plan, Auto)."
        },
        "agentDev.claudePath": {
          "type": "string",
          "default": "",
          "description": "Chemin vers un binaire `claude` installé séparément. À renseigner seulement si le binaire embarqué est introuvable."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package": "npm run compile && vsce package --allow-missing-repository --skip-license"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.303"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.5.0"
  }
}
